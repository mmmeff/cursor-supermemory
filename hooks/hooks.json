{
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/session-start.js\"",
        "timeout": 20
      }
    ],
    "beforeSubmitPrompt": [
      {
        "type": "command",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/before-submit-prompt.js\"",
        "timeout": 45
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/post-tool-use.js\"",
        "timeout": 60
      }
    ],
    "afterAgentThought": [
      {
        "type": "command",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/after-agent-thought.js\"",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "type": "command",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/stop.js\"",
        "timeout": 120
      }
    ],
    "preCompact": [
      {
        "type": "command",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/pre-compact.js\"",
        "timeout": 120
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/session-end.js\"",
        "timeout": 120
      }
    ]
  }
}
